# Copy to .env for local runs (docker compose reads it). On ncsa-01 these come
# from the deployments repo: env/*.env (plain) and secrets/*.sops.env (keys).

# --- secrets ---
# Outline API key of the "Transcription Bot" user (Settings -> API & Apps).
OUTLINE_API_KEY=
# NCSA Lumen key (OpenAI-compatible, zero data retention).
LUMEN_API_KEY=

# --- settings ---
OUTLINE_URL=https://wiki.quantum-aspen.net
# The "Recordings inbox" doc: its id or the url id at the end of its link.
INBOX_DOC=
LUMEN_BASE_URL=https://lumen.ncsa.illinois.edu/v1
# A model id from GET $LUMEN_BASE_URL/models. It should accept images (scene frames),
# or set LUMEN_VISION_MODEL to one that does.
LUMEN_MODEL=
LUMEN_VISION_MODEL=
# Seconds between inbox checks.
POLL_INTERVAL=300
# Only start jobs in this window (24h clock, container TZ), e.g. 22-6. Empty = any time.
RUN_HOURS=
TZ=America/Chicago
# 1 = never write to the wiki; the agent writes summary.md in the work dir instead.
DRY_RUN=
